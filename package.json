{
  "name": "hossein-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "typecheck": "tsc -b",
    "format": "prettier --write src tests scripts *.ts *.json index.html public/resume.* README.md",
    "format:check": "prettier --check src tests scripts *.ts *.json index.html public/resume.* README.md",
    "assets": "node scripts/generate-previews.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@playwright/test": "^1.55.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
